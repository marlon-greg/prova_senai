rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- quem é quem ----------
    function logado()      { return request.auth != null && request.auth.token.email_verified == true; }
    function email()       { return request.auth.token.email; }
    function uid()         { return request.auth.uid; }
    function superAdmin()  { return email() == 'marlon.frodrigues@docente.senai.br'; }
    function membro()      { return exists(/databases/$(db)/documents/equipe/$(email())); }
    function papel()       { return get(/databases/$(db)/documents/equipe/$(email())).data.papel; }
    function equipe()      { return logado() && (superAdmin() || membro()); }
    function professor()   { return logado() && (superAdmin() || (membro() && papel() in ['admin', 'professor'])); }
    function admin()       { return logado() && (superAdmin() || (membro() && papel() == 'admin')); }
    function dominio()     { return email().split('@')[1]; }
    function aluno()       { return logado() && !equipe()
                               && dominio() in get(/databases/$(db)/documents/config/geral).data.dominiosAlunos; }
    function prova(id)     { return get(/databases/$(db)/documents/provas/$(id)).data; }
    function tentativa(id) { return get(/databases/$(db)/documents/tentativas/$(id)).data; }
    // tentativa de teste da própria pessoa da equipe
    function meuTeste(id)  { return equipe() && tentativa(id).teste == true && tentativa(id).uid == uid(); }

    // ---------- configuração ----------
    match /config/geral {
      allow read: if logado();
      allow write: if admin();
    }

    // ---------- equipe ----------
    match /equipe/{em} {
      allow read: if equipe() || (logado() && em == email());
      allow write: if admin();
    }

    // ---------- bancos de questões ----------
    match /bancos/{b} {
      allow read: if equipe() || aluno();
      allow write: if professor();
      match /questoes/{q} {
        allow read: if equipe() || aluno();
        allow write: if professor();
      }
      // gabarito: o aluno SÓ lê depois de responder (marcador) ou de finalizar
      match /gabaritos/{q} {
        allow read: if equipe()
                    || (aluno() && exists(/databases/$(db)/documents/marcadores/$(uid() + '_' + q)));
        allow write: if professor();
      }
    }

    // marcador "já respondi / já finalizei"
    match /marcadores/{m} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());
      allow create: if aluno()
        && m == uid() + '_' + request.resource.data.qid
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'qid', 'provaId', 'criadoEm'])
        && request.resource.data.qid in getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.questoesIds
        && ( existsAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)/respostas/$(request.resource.data.qid))
             || getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.finalizadaEm != null );
      allow update, delete: if admin();
    }

    // ---------- turmas (lista de e-mails dos alunos) ----------
    match /turmas/{id} {
      allow read: if equipe() || (logado() && email().lower() in resource.data.emails);
      allow write: if professor();
    }

    // ---------- provas ----------
    match /provas/{p} {
      allow read: if equipe()
                  || (aluno() && (resource.data.liberada == true || resource.data.resultadosLiberados == true));
      allow write: if professor();
    }

    // ---------- tentativas ----------
    match /tentativas/{t} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());

      // ALUNO: cria a própria, uma vez, com a prova liberada
      allow create: if (aluno()
        && t == uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'provaId', 'bancoId', 'questoesIds',
                                                 'iniciadaEm', 'finalizadaEm', 'indiceAtual', 'trocasDeAba',
                                                 'notaPrevia', 'aguardandoCorrecao',
                                                 'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                                                 'encerradaPor', 'trocasDeAbaTotal', 'codigoInformado'])
        && prova(request.resource.data.provaId).liberada == true
        && request.resource.data.bancoId == prova(request.resource.data.provaId).bancoId
        && request.resource.data.questoesIds.size() == prova(request.resource.data.provaId).nQuestoes
        && request.resource.data.finalizadaEm == null
        && request.resource.data.iniciadaEm == request.time
        // turma: sem turma = qualquer aluno; com turma = o e-mail precisa estar na lista
        // (.get com padrão: provas antigas não têm turmaId/codigoAcesso, e campo ausente dá erro nas regras)
        && (prova(request.resource.data.provaId).get('turmaId', null) == null
            || email().lower() in get(/databases/$(db)/documents/turmas/$(prova(request.resource.data.provaId).turmaId)).data.emails)
        // código de acesso: se a prova tiver, o aluno precisa informar igual
        && (prova(request.resource.data.provaId).get('codigoAcesso', '') in [null, '']
            || request.resource.data.get('codigoInformado', '') == prova(request.resource.data.provaId).codigoAcesso))
      // EQUIPE: tentativa de teste (não exige prova liberada)
      || (equipe()
        && t == 'teste_' + uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.teste == true);

      allow update: if
           // aluno: só avança, conta sinais e finaliza — nunca mexe nas questões sorteadas
           (logado() && resource.data.uid == uid() && resource.data.teste != true
            && resource.data.finalizadaEm == null
            && prova(resource.data.provaId).liberada == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['finalizadaEm', 'indiceAtual', 'trocasDeAba', 'notaPrevia', 'aguardandoCorrecao',
                  'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                  'encerradaPor', 'trocasDeAbaTotal']))
           // professor fecha a nota
        || (professor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nota', 'notaMaxima', 'corrigidaEm', 'corrigidaPor']))
           // equipe: a própria tentativa de teste
        || (equipe() && resource.data.teste == true && resource.data.uid == uid());

      allow delete: if admin() || (equipe() && resource.data.teste == true && resource.data.uid == uid());

      // respostas: o aluno grava uma vez, nunca altera
      match /respostas/{q} {
        allow read: if equipe() || (logado() && tentativa(t).uid == uid());
        allow create: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && q in tentativa(t).questoesIds
          && request.resource.data.keys().hasOnly(['resposta', 'enviadaEm', 'segundos', 'perdida'])
          && request.resource.data.enviadaEm == request.time)
          || meuTeste(t);
        allow update: if false;
        allow delete: if admin() || meuTeste(t);
      }

      // correção manual (dissertativas)
      match /correcoes/{q} {
        allow read: if equipe()
                    || (logado() && tentativa(t).uid == uid() && prova(tentativa(t).provaId).resultadosLiberados == true);
        allow write: if professor() || (meuTeste(t) && request.method == 'delete');
      }
    }
  }
}
