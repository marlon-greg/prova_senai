rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- quem é quem ----------
    function logado()      { return request.auth != null && request.auth.token.email_verified == true; }
    function email()       { return request.auth.token.email; }
    function uid()         { return request.auth.uid; }
    function superAdmin()  { return email() == 'marlon.frodrigues@docente.senai.br'; }
    function membro()      { return exists(/databases/$(db)/documents/equipe/$(email())); }
    function papel()       { return get(/databases/$(db)/documents/equipe/$(email())).data.papel; }
    function equipe()      { return logado() && (superAdmin() || membro()); }
    function professor()   { return logado() && (superAdmin() || (membro() && papel() in ['admin', 'professor'])); }
    function admin()       { return logado() && (superAdmin() || (membro() && papel() == 'admin')); }
    function dominio()     { return email().split('@')[1]; }
    function aluno()       { return logado() && !equipe()
                               && dominio() in get(/databases/$(db)/documents/config/geral).data.dominiosAlunos; }
    function prova(id)     { return get(/databases/$(db)/documents/provas/$(id)).data; }
    function tentativa(id) { return get(/databases/$(db)/documents/tentativas/$(id)).data; }
    // chave do nome completo (IGUAL à função chaveNome de js/common.js):
    // minúsculas, sem acento, só letras, palavras separadas por "_"  ("José  da Silva" -> "jose_da_silva")
    function chaveNome(n) {
      return n.lower().replace('\\p{M}+', '')
              .replace('[áàâãäÁÀÂÃÄ]', 'a').replace('[éèêëÉÈÊË]', 'e').replace('[íìîïÍÌÎÏ]', 'i')
              .replace('[óòôõöÓÒÔÕÖ]', 'o').replace('[úùûüÚÙÛÜ]', 'u').replace('[çÇ]', 'c').replace('[ñÑ]', 'n')
              .replace('[^a-z]+', ' ').trim().replace(' ', '_');
    }
    function meuNome()     { return 'name' in request.auth.token && request.auth.token.name is string
                                    ? chaveNome(request.auth.token.name) : ''; }
    // ---------- acessibilidade / auxiliar de inclusão ----------
    // papel 'inclusao' = auxiliar de inclusão: só vê e cuida dos alunos vinculados a ela
    // (acessibilidade/{emailAluno}.auxiliares). Os outros papéis da equipe veem tudo, como antes.
    function inclusao()    { return logado() && !superAdmin() && membro() && papel() == 'inclusao'; }
    function equipeGeral() { return logado() && (superAdmin() || (membro() && papel() != 'inclusao')); }
    function minhaAluna(e) { return inclusao() && exists(/databases/$(db)/documents/acessibilidade/$(e))
                               && email().lower() in get(/databases/$(db)/documents/acessibilidade/$(e)).data.get('auxiliares', []); }
    function cuidaDe(e)    { return professor() || minhaAluna(e); }
    function eu(e)         { return logado() && email().lower() == e; }
    // tentativa de teste da própria pessoa da equipe
    // sorteio feito pelo professor para o aluno com acessibilidade (acessibilidade/{email}.sorteios.{prova}.ids)
    function sorteioAcess(p) {
      let caminho = /databases/$(db)/documents/acessibilidade/$(email().lower());
      return exists(caminho) ? get(caminho).data.get('sorteios', {}).get(p, {}).get('ids', []) : [];
    }
    function meuTeste(id)  { return equipe() && tentativa(id).get('teste', false) == true && tentativa(id).uid == uid(); }

    // ---------- configuração ----------
    match /config/geral {
      allow read: if logado();
      allow write: if admin();
    }
    // chave da API da IA: SÓ o administrador principal (nem outros admins, nem professores, nem alunos)
    match /config/ia {
      allow read, write: if superAdmin();
    }

    // ---------- equipe ----------
    match /equipe/{em} {
      allow read: if equipe() || (logado() && em == email());
      allow write: if admin();
    }

    // ---------- bancos de questões ----------
    match /bancos/{b} {
      allow read: if equipe() || aluno();
      allow write: if professor();
      match /questoes/{q} {
        allow read: if equipe() || aluno();
        allow write: if professor();
      }
      // gabarito: o aluno SÓ lê depois de finalizar a prova (marcador)
      match /gabaritos/{q} {
        allow read: if equipe()
                    || (aluno() && exists(/databases/$(db)/documents/marcadores/$(uid() + '_' + q)));
        allow write: if professor();
      }
    }

    // marcador "já finalizei": libera o gabarito da questão. Só depois de FINALIZAR a prova
    // (ninguém lê gabarito durante a prova, nem com "ir e voltar")
    match /marcadores/{m} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());
      allow create: if aluno()
        && m == uid() + '_' + request.resource.data.qid
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'qid', 'provaId', 'criadoEm'])
        && request.resource.data.qid in getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.questoesIds
        && getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.finalizadaEm != null;
      allow update: if admin();
      allow delete: if professor() || inclusao();   // reabrir a prova do aluno apaga os marcadores (o gabarito volta a ficar fechado)
    }

    // ---------- turmas ----------
    // emails     = alunos que podem fazer as provas da turma (o que vale para as regras)
    // nomesChave = nomes completos ainda sem e-mail (cadastrados só pelo nome)
    // vinculos   = { chaveDoNome: email } — o aluno se vincula sozinho no 1º login, se o nome da conta Google bater
    match /turmas/{id} {
      allow read: if equipe()
                  || (logado() && email().lower() in resource.data.emails)
                  || (aluno() && meuNome() != '' && meuNome() in resource.data.get('nomesChave', []));
      allow create, delete: if professor();
      allow update: if professor() || (aluno() && vinculoPeloNome());
    }
    // o aluno só pode: acrescentar o PRÓPRIO e-mail e o vínculo do PRÓPRIO nome (uma vez; nome já vinculado não muda)
    function vinculoPeloNome() {
      let chave = meuNome();
      let antes = resource.data.get('vinculos', {});
      let depois = request.resource.data.get('vinculos', {});
      return chave != ''
        && chave in resource.data.get('nomesChave', [])
        && !(chave in antes)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails', 'vinculos'])
        && depois.diff(antes).affectedKeys().hasOnly([chave])
        && depois[chave] == email().lower()
        && request.resource.data.emails.toSet() == resource.data.emails.toSet().union([email().lower()].toSet());
    }

    // ---------- materiais de consulta (PDF enviado pelo professor, em pedaços de ~900 KB, até 20 MB) ----------
    match /materiais/{m} {
      allow read: if equipe() || aluno();
      allow write: if professor();
      match /partes/{p} {
        allow read: if equipe() || aluno();
        allow write: if professor();
      }
    }

    // ---------- acessibilidade (adaptações da prova por aluno) ----------
    // acessibilidade/{email}: o que o PRÓPRIO aluno lê (visual, tempo/vidas extras) + questões reescritas para ele.
    // A auxiliar de inclusão edita, mas não muda quem está vinculado (só professor).
    match /acessibilidade/{e} {
      allow read: if equipeGeral() || minhaAluna(e) || eu(e)
                  || (inclusao() && email().lower() in resource.data.auxiliares);   // lista "meus alunos" (array-contains)
      allow create, delete: if professor();
      allow update: if professor()
        || (minhaAluna(e) && request.resource.data.get('auxiliares', []) == resource.data.get('auxiliares', []))
        // o próprio aluno grava só o uid dele (assim a auxiliar acha as tentativas: tentativas/{uid}_{prova})
        || (eu(e) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) && request.resource.data.uid == uid());
      match /questoes/{q} {
        allow read: if equipeGeral() || minhaAluna(e) || eu(e);
        allow write: if cuidaDe(e);
      }
    }
    // acessibilidadePrivado/{email}: descrição do professor, laudos (PDF em pedaços) e sugestões — o aluno NÃO lê
    match /acessibilidadePrivado/{e} {
      allow read, write: if cuidaDe(e);
      match /laudos/{l} {
        allow read, write: if cuidaDe(e);
        match /partes/{p} { allow read, write: if cuidaDe(e); }
      }
      match /sugestoes/{s} {
        allow read: if cuidaDe(e);
        allow create: if cuidaDe(e) && request.resource.data.autor == email().lower();
        allow update, delete: if professor() || (cuidaDe(e) && resource.data.autor == email().lower());
      }
    }

    // ---------- provas ----------
    match /provas/{p} {
      allow read: if equipe()
                  || (aluno() && (resource.data.liberada == true || resource.data.resultadosLiberados == true));
      allow write: if professor();
    }

    // ---------- tentativas ----------
    match /tentativas/{t} {
      // aluno: a própria. "resource == null" = ainda não começou (a lista de provas confere se já existe);
      // só vale para o id dele (uid_prova), para não descobrir quem começou
      allow read: if equipeGeral()
                  || (resource != null && minhaAluna(resource.data.email.lower()))
                  || (logado() && (resource == null ? t.matches(uid() + '_.+') : resource.data.uid == uid()));

      // ALUNO: cria a própria, uma vez, com a prova liberada
      allow create: if (aluno()
        && t == uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'provaId', 'bancoId', 'questoesIds',
                                                 'iniciadaEm', 'finalizadaEm', 'indiceAtual', 'trocasDeAba',
                                                 'notaPrevia', 'aguardandoCorrecao',
                                                 'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                                                 'encerradaPor', 'trocasDeAbaTotal', 'codigoInformado'])
        && prova(request.resource.data.provaId).liberada == true
        && request.resource.data.bancoId == prova(request.resource.data.provaId).bancoId
        // nº de questões da prova, ou exatamente as questões sorteadas pelo professor na acessibilidade (quantidade livre)
        && (request.resource.data.questoesIds.size() == prova(request.resource.data.provaId).nQuestoes
            || (request.resource.data.questoesIds.size() > 0
                && request.resource.data.questoesIds == sorteioAcess(request.resource.data.provaId)))
        && request.resource.data.finalizadaEm == null
        && request.resource.data.iniciadaEm == request.time
        // turma: a prova PRECISA ter turma e o e-mail do aluno precisa estar na lista dela (prova sem turma = ninguém faz)
        // (.get com padrão: provas antigas não têm turmaId/codigoAcesso, e campo ausente dá erro nas regras)
        && prova(request.resource.data.provaId).get('turmaId', null) != null
        && email().lower() in get(/databases/$(db)/documents/turmas/$(prova(request.resource.data.provaId).turmaId)).data.emails
        // código de acesso: se a prova tiver, o aluno precisa informar igual
        && (prova(request.resource.data.provaId).get('codigoAcesso', '') in [null, '']
            || request.resource.data.get('codigoInformado', '') == prova(request.resource.data.provaId).codigoAcesso))
      // EQUIPE: tentativa de teste (não exige prova liberada)
      || (equipe()
        && t == 'teste_' + uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.get('teste', false) == true);

      allow update: if
           // aluno: só avança, conta sinais e finaliza — nunca mexe nas questões sorteadas nem no placar
           (logado() && resource.data.uid == uid() && resource.data.get('teste', false) != true
            && resource.data.finalizadaEm == null
            && prova(resource.data.provaId).liberada == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['finalizadaEm', 'indiceAtual', 'trocasDeAba',
                  'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                  'encerradaPor', 'trocasDeAbaTotal'])
            // vidas: o aluno não "recupera" vidas sozinho (perder a questão zera trocasDeAba, mas soma em trocasDeAbaTotal)
            && request.resource.data.get('trocasDeAba', 0) + request.resource.data.get('trocasDeAbaTotal', 0)
                 >= resource.data.get('trocasDeAba', 0) + resource.data.get('trocasDeAbaTotal', 0))
           // professor: fecha a nota e grava o placar que o aluno vê (acertos, nota prévia, pendentes)
           // e cuida das VIDAS do aluno: restaurar, dar vida extra, reabrir a prova (ex.: aluno com TEA)
        || (professor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['nota', 'notaMaxima', 'corrigidaEm', 'corrigidaPor',
                  'acertos', 'totalQuestoes', 'notaPrevia', 'aguardandoCorrecao',
                  'trocasDeAba', 'trocasDeAbaTotal', 'vidasExtras', 'vidasRestauradas', 'vidasRestauradasEm',
                  'vidasRestauradasPor', 'finalizadaEm', 'encerradaPor', 'indiceAtual', 'tempoTotalSegundos',
                  'minutosExtras', 'reabertaEm', 'reabertaPor']))
           // auxiliar de inclusão: vidas e reabrir a prova dos alunos vinculados a ela
        || (minhaAluna(resource.data.email.lower())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['trocasDeAba', 'trocasDeAbaTotal', 'vidasExtras', 'vidasRestauradas', 'vidasRestauradasEm',
                  'vidasRestauradasPor', 'finalizadaEm', 'encerradaPor', 'indiceAtual', 'tempoTotalSegundos',
                  'minutosExtras', 'reabertaEm', 'reabertaPor', 'acertos', 'totalQuestoes', 'nota', 'notaPrevia', 'aguardandoCorrecao']))
           // equipe: a própria tentativa de teste
        || (equipe() && resource.data.get('teste', false) == true && resource.data.uid == uid());

      allow delete: if admin() || (equipe() && resource.data.get('teste', false) == true && resource.data.uid == uid());

      // respostas: o aluno grava uma vez; com "ir e voltar" (prova.permitirVoltar) pode alterar até finalizar
      match /respostas/{q} {
        allow read: if equipeGeral() || minhaAluna(tentativa(t).email.lower()) || (logado() && tentativa(t).uid == uid());
        allow create: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && q in tentativa(t).questoesIds
          && request.resource.data.keys().hasOnly(['resposta', 'enviadaEm', 'segundos', 'perdida'])
          && request.resource.data.enviadaEm == request.time)
          || meuTeste(t);
        allow update: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && prova(tentativa(t).provaId).get('permitirVoltar', false) == true
          && resource.data.get('perdida', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'segundos', 'atualizadaEm'])
          && request.resource.data.atualizadaEm == request.time)
          || meuTeste(t);
        allow delete: if admin() || meuTeste(t)
          || (cuidaDe(tentativa(t).email.lower()) && resource.data.get('perdida', false) == true);   // devolver questão perdida por sair da prova
      }

      // correção manual (dissertativas)
      match /correcoes/{q} {
        allow read: if equipeGeral() || minhaAluna(tentativa(t).email.lower())
                    || (logado() && tentativa(t).uid == uid() && prova(tentativa(t).provaId).resultadosLiberados == true);
        allow write: if professor() || (meuTeste(t) && request.method == 'delete');
      }
    }
  }
}
