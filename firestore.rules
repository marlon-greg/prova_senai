rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---------- quem é quem ----------
    function logado()      { return request.auth != null && request.auth.token.email_verified == true; }
    function email()       { return request.auth.token.email; }
    function uid()         { return request.auth.uid; }
    function superAdmin()  { return email() == 'marlon.frodrigues@docente.senai.br'; }
    function membro()      { return exists(/databases/$(db)/documents/equipe/$(email())); }
    function papel()       { return get(/databases/$(db)/documents/equipe/$(email())).data.papel; }
    function equipe()      { return logado() && (superAdmin() || membro()); }
    function professor()   { return logado() && (superAdmin() || (membro() && papel() in ['admin', 'professor'])); }
    function admin()       { return logado() && (superAdmin() || (membro() && papel() == 'admin')); }
    function dominio()     { return email().split('@')[1]; }
    function aluno()       { return logado() && !equipe()
                               && dominio() in get(/databases/$(db)/documents/config/geral).data.dominiosAlunos; }
    function prova(id)     { return get(/databases/$(db)/documents/provas/$(id)).data; }
    function tentativa(id) { return get(/databases/$(db)/documents/tentativas/$(id)).data; }
    // chave do nome completo (IGUAL à função chaveNome de js/common.js):
    // minúsculas, sem acento, só letras, palavras separadas por "_"  ("José  da Silva" -> "jose_da_silva")
    function chaveNome(n) {
      return n.lower().replace('\\p{M}+', '')
              .replace('[áàâãäÁÀÂÃÄ]', 'a').replace('[éèêëÉÈÊË]', 'e').replace('[íìîïÍÌÎÏ]', 'i')
              .replace('[óòôõöÓÒÔÕÖ]', 'o').replace('[úùûüÚÙÛÜ]', 'u').replace('[çÇ]', 'c').replace('[ñÑ]', 'n')
              .replace('[^a-z]+', ' ').trim().replace(' ', '_');
    }
    function meuNome()     { return 'name' in request.auth.token && request.auth.token.name is string
                                    ? chaveNome(request.auth.token.name) : ''; }
    // ---------- acessibilidade / auxiliar de inclusão ----------
    // papel 'inclusao' = auxiliar de inclusão: só vê e cuida dos alunos vinculados a ela
    // (acessibilidade/{emailAluno}.auxiliares). Os outros papéis da equipe veem tudo, como antes.
    function inclusao()    { return logado() && !superAdmin() && membro() && papel() == 'inclusao'; }
    function equipeGeral() { return logado() && (superAdmin() || (membro() && papel() != 'inclusao')); }
    function minhaAluna(e) { return inclusao() && exists(/databases/$(db)/documents/acessibilidade/$(e))
                               && email().lower() in get(/databases/$(db)/documents/acessibilidade/$(e)).data.get('auxiliares', []); }
    function cuidaDe(e)    { return professor() || minhaAluna(e); }
    function eu(e)         { return logado() && email().lower() == e; }
    // tentativa de teste da própria pessoa da equipe
    // sorteio feito pelo professor para o aluno com acessibilidade (acessibilidade/{email}.sorteios.{prova}.ids)
    function sorteioAcess(p) {
      let caminho = /databases/$(db)/documents/acessibilidade/$(email().lower());
      return exists(caminho) ? get(caminho).data.get('sorteios', {}).get(p, {}).get('ids', []) : [];
    }
    function meuTeste(id)  { return equipe() && tentativa(id).get('teste', false) == true && tentativa(id).uid == uid(); }

    // ---------- configuração ----------
    match /config/geral {
      allow read: if logado();
      allow write: if admin();
    }
    // gamificação: o que está ligado (conquistas, skins, apontamentos, sugestões, social). Todos leem; só admin muda.
    // conquistas configuradas pelo admin (regras, títulos, emojis); sem o documento vale o padrão do código
    match /config/conquistas {
      allow read: if logado();
      allow write: if admin();
    }
    match /config/mascotes {
      allow read: if logado();
      allow write: if admin();
    }
    match /config/gamificacao {
      allow read: if logado();
      allow write: if admin();
    }
    // chave da API da IA: SÓ o administrador principal (nem outros admins, nem professores, nem alunos)
    match /config/ia {
      allow read, write: if superAdmin();
    }

    // ---------- equipe ----------
    match /equipe/{em} {
      allow read: if equipe() || (logado() && em == email());
      allow write: if admin();
    }

    // ---------- mascotes dos professores ----------
    // estilo em uso (ativo) + até 4 "saves". Todos leem (o aluno vê o mascote com o estilo do professor);
    // só o professor dono do mascote (config/mascotes.donos[id] = e-mail, definido pelo admin) ou o admin mudam.
    match /mascotes/{m} {
      allow read: if logado();
      allow write: if (admin() || get(/databases/$(db)/documents/config/mascotes).data.get('donos', {}).get(m, '') == email().lower())
                   && request.resource.data.keys().hasOnly(['ativo', 'saves', 'atualizadoEm', 'atualizadoPor'])
                   && request.resource.data.get('saves', []).size() <= 4;
    }

    // ---------- itens criados pela equipe (PNG em data URL, até ~600 KB) ----------
    match /itensCustom/{i} {
      allow read: if logado();
      allow write: if professor() && (request.method == 'delete' || request.resource.data.png.size() < 700000);
    }

    // ---------- bancos de questões ----------
    match /bancos/{b} {
      allow read: if equipe() || aluno();
      allow write: if professor();
      match /questoes/{q} {
        allow read: if equipe() || aluno();
        allow write: if professor();
      }
      // gabarito: o aluno SÓ lê depois de finalizar a prova (marcador)
      match /gabaritos/{q} {
        allow read: if equipe()
                    || (aluno() && exists(/databases/$(db)/documents/marcadores/$(uid() + '_' + q)));
        allow write: if professor();
      }
    }

    // marcador "já finalizei": libera o gabarito da questão. Só depois de FINALIZAR a prova
    // (ninguém lê gabarito durante a prova, nem com "ir e voltar")
    match /marcadores/{m} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());
      allow create: if aluno()
        && m == uid() + '_' + request.resource.data.qid
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'qid', 'provaId', 'criadoEm'])
        && request.resource.data.qid in getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.questoesIds
        && getAfter(/databases/$(db)/documents/tentativas/$(uid() + '_' + request.resource.data.provaId)).data.finalizadaEm != null;
      allow update: if admin();
      allow delete: if professor() || inclusao();   // reabrir a prova do aluno apaga os marcadores (o gabarito volta a ficar fechado)
    }

    // ---------- turmas ----------
    // emails     = alunos que podem fazer as provas da turma (o que vale para as regras)
    // nomesChave = nomes completos ainda sem e-mail (cadastrados só pelo nome)
    // vinculos   = { chaveDoNome: email } — o aluno se vincula sozinho no 1º login, se o nome da conta Google bater
    match /turmas/{id} {
      allow read: if equipe()
                  || (logado() && email().lower() in resource.data.emails)
                  || (aluno() && meuNome() != '' && meuNome() in resource.data.get('nomesChave', []));
      allow create, delete: if professor();
      allow update: if professor() || (aluno() && vinculoPeloNome());
    }
    // o aluno só pode: acrescentar o PRÓPRIO e-mail e o vínculo do PRÓPRIO nome (uma vez; nome já vinculado não muda)
    function vinculoPeloNome() {
      let chave = meuNome();
      let antes = resource.data.get('vinculos', {});
      let depois = request.resource.data.get('vinculos', {});
      return chave != ''
        && chave in resource.data.get('nomesChave', [])
        && !(chave in antes)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails', 'vinculos'])
        && depois.diff(antes).affectedKeys().hasOnly([chave])
        && depois[chave] == email().lower()
        && request.resource.data.emails.toSet() == resource.data.emails.toSet().union([email().lower()].toSet());
    }

    // ---------- materiais de consulta (PDF enviado pelo professor, em pedaços de ~900 KB, até 20 MB) ----------
    match /materiais/{m} {
      allow read: if equipe() || aluno();
      allow write: if professor();
      match /partes/{p} {
        allow read: if equipe() || aluno();
        allow write: if professor();
      }
    }

    // ---------- organização: plano de ensino de cada matéria (turma + semestre + matéria) ----------
    // planos/{id}: tópicos com datas e provas previstas; arquivos = PDF do plano (em pedaços, como os materiais)
    match /planos/{id} {
      allow read: if equipe();
      allow write: if professor();
      match /arquivos/{a} {
        allow read: if equipe();
        allow write: if professor();
        match /partes/{x} {
          allow read: if equipe();
          allow write: if professor();
        }
      }
    }

    // plano de curso: todas as matérias do curso com os tópicos (turmas/{id}.cursoId aponta para cá)
    match /cursos/{id} {
      allow read: if equipe();
      allow write: if professor();
      match /arquivos/{a} {
        allow read: if equipe();
        allow write: if professor();
        match /partes/{x} {
          allow read: if equipe();
          allow write: if professor();
        }
      }
    }

    // ---------- acessibilidade (adaptações da prova por aluno) ----------
    // acessibilidade/{email}: o que o PRÓPRIO aluno lê (visual, tempo/vidas extras) + questões reescritas para ele.
    // A auxiliar de inclusão edita, mas não muda quem está vinculado (só professor).
    match /acessibilidade/{e} {
      allow read: if equipeGeral() || minhaAluna(e) || eu(e)
                  || (inclusao() && email().lower() in resource.data.auxiliares);   // lista "meus alunos" (array-contains)
      allow create, delete: if professor();
      allow update: if professor()
        || (minhaAluna(e) && request.resource.data.get('auxiliares', []) == resource.data.get('auxiliares', []))
        // o próprio aluno grava só o uid dele (assim a auxiliar acha as tentativas: tentativas/{uid}_{prova})
        || (eu(e) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']) && request.resource.data.uid == uid());
      match /questoes/{q} {
        allow read: if equipeGeral() || minhaAluna(e) || eu(e);
        allow write: if cuidaDe(e);
      }
    }
    // acessibilidadePrivado/{email}: descrição do professor, laudos (PDF em pedaços) e sugestões — o aluno NÃO lê
    match /acessibilidadePrivado/{e} {
      allow read, write: if cuidaDe(e);
      match /laudos/{l} {
        allow read, write: if cuidaDe(e);
        match /partes/{p} { allow read, write: if cuidaDe(e); }
      }
      // gabarito das questões adaptadas em outro formato (V/F, ligar, lacunas…): a equipe grava;
      // o aluno só lê depois de FINALIZAR a prova (marcador), igual ao gabarito do banco
      match /gabaritos/{q} {
        allow read: if cuidaDe(e) || (eu(e) && exists(/databases/$(db)/documents/marcadores/$(uid() + '_' + q)));
        allow write: if cuidaDe(e);
      }
      // opções de formato sugeridas pela IA e o histórico das escolhas (a equipe vê; o aluno não)
      match /opcoes/{q} { allow read, write: if cuidaDe(e); }
      match /historico/{h} { allow read, create: if cuidaDe(e); allow delete: if admin(); }
      // diário do aluno: a auxiliar de inclusão vinculada escreve (id = data_autor); professores e admin leem e comentam
      match /diario/{d} {
        allow read: if cuidaDe(e);
        // aluno FICTÍCIO do ambiente de teste (menu Simulação): a equipe grava e apaga o diário de mentira
        allow create, update, delete: if professor() && e.matches('.+@simulacao[.]teste');
        allow create: if (minhaAluna(e) || superAdmin()) && request.resource.data.autor == email().lower()
                      && d == request.resource.data.data + '_' + email().lower();
        allow update: if ((minhaAluna(e) || superAdmin()) && resource.data.autor == email().lower()
                          && request.resource.data.autor == resource.data.autor && request.resource.data.data == resource.data.data)
                      // quem comenta só soma o contador de comentários
                      || (cuidaDe(e) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nComentarios', 'ultimoComentarioEm']));
        allow delete: if (minhaAluna(e) || superAdmin()) && resource.data.autor == email().lower() || admin();
        match /comentarios/{c} {
          allow read: if cuidaDe(e);
          allow create: if cuidaDe(e) && request.resource.data.autor == email().lower();
          allow delete: if (cuidaDe(e) && resource.data.autor == email().lower()) || admin();
        }
      }
      match /sugestoes/{s} {
        allow read: if cuidaDe(e);
        allow create: if cuidaDe(e) && request.resource.data.autor == email().lower();
        allow update, delete: if professor() || (cuidaDe(e) && resource.data.autor == email().lower());
      }
    }

    // ---------- retorno dos alunos ----------
    // apontamento numa questão (duplicidade de respostas, erro…): o aluno cria o dele; a equipe lê e responde
    match /apontamentos/{id} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());
      allow create: if logado() && request.resource.data.uid == uid() && request.resource.data.email == email().lower()
                    && request.resource.data.status == 'aberto'
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'provaId', 'provaTitulo', 'qid', 'enunciado', 'tipo', 'texto', 'status', 'criadoEm'])
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000;
      allow update: if professor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resposta', 'respondidoPor', 'respondidoEm']);
      allow delete: if admin();
    }
    // sugestão para o sistema
    match /sugestoesSistema/{id} {
      allow read: if equipe() || (logado() && resource.data.uid == uid());
      allow create: if logado() && request.resource.data.uid == uid() && request.resource.data.status == 'aberta'
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'categoria', 'texto', 'status', 'criadoEm'])
                    && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000;
      allow update: if professor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resposta', 'respondidoPor', 'respondidoEm']);
      allow delete: if admin();
    }
    // perfil do aluno: personagem (avatar), apelido e o que ele escolheu compartilhar.
    // Só o dono lê e grava; os outros só leem a VITRINE (perfisPublicos), e só se a parte social estiver ligada.
    match /perfis/{u} {
      allow read: if logado() && (u == uid() || equipe());
      // alunos FICTÍCIOS do ambiente de teste (menu Simulação)
      allow write: if professor() && u.matches('sim-.+');
      allow write: if logado() && u == uid()
                   && request.resource.data.keys().hasOnly(['avatar', 'apelido', 'status', 'statusEm', 'email', 'cartao', 'saves', 'atualizadoEm'])
                   && request.resource.data.get('saves', []).size() <= 4
                   && (!('email' in request.resource.data) || request.resource.data.email == email().lower())
                   && (!('cartao' in request.resource.data) || (request.resource.data.cartao is map && request.resource.data.cartao.keys().hasOnly(['foto', 'lado', 'medalhas'])))
                   && (!('status' in request.resource.data) || (request.resource.data.status is string && request.resource.data.status.size() <= 40));
    }
    // quem lê também está no mural (tem vitrine) e na mesma turma
    function mesmaTurma(t) { return t != null && exists(/databases/$(db)/documents/vitrine/$(uid())) && get(/databases/$(db)/documents/vitrine/$(uid())).data.turmaId == t; }
    function socialLigado() { return get(/databases/$(db)/documents/config/gamificacao).data.get('social', false) == true; }
    // vitrine: só o que o próprio aluno marcou para mostrar (nunca nota sem ele querer)
    match /vitrine/{u} {
      // colega: só com a parte social ligada, se ELE TAMBÉM compartilha (tem vitrine) e é da MESMA turma
      allow read: if logado() && (u == uid() || equipe() || (socialLigado() && mesmaTurma(resource.data.turmaId)));
      allow write: if logado() && u == uid()
                   && request.resource.data.keys().hasOnly(['nome', 'apelido', 'avatar', 'status', 'turmaId', 'conquistas', 'notas', 'nivel', 'atualizadoEm'])
                   // a turma gravada precisa ser uma turma em que o aluno está
                   && (request.resource.data.turmaId == null || (request.resource.data.turmaId is string && exists(/databases/$(db)/documents/turmas/$(request.resource.data.turmaId))
                       && email().lower() in get(/databases/$(db)/documents/turmas/$(request.resource.data.turmaId)).data.get('emails', [])))
                   // status difíceis nunca vão para o mural (só a equipe vê, em perfis)
                   && !(request.resource.data.get('status', '') in ['😫 Cansado(a)', '😔 Triste', '😟 Preocupado(a)', '😰 Ansioso(a)', '😣 Estressado(a)', '😠 Irritado(a)', '🤒 Não estou bem']);
      // curtidas e parabéns (sem comentários): uma por pessoa, só com a parte social ligada
      match /reacoes/{de} {
        allow read: if logado() && (u == uid() || de == uid() || equipe() || (socialLigado() && mesmaTurma(get(/databases/$(db)/documents/vitrine/$(u)).data.turmaId)));
        allow create, update: if logado() && de == uid() && de != u && socialLigado() && mesmaTurma(get(/databases/$(db)/documents/vitrine/$(u)).data.turmaId)
                              && request.resource.data.keys().hasOnly(['tipo', 'item', 'em']) && request.resource.data.tipo in ['curtida', 'parabens'];
        allow delete: if logado() && (de == uid() || admin());
      }
    }

    // ---------- provas ----------
    match /provas/{p} {
      allow read: if equipe()
                  || (aluno() && (resource.data.liberada == true || resource.data.resultadosLiberados == true))
                  // a prova que o aluno já fez (título e matéria para as conquistas dele)
                  || (aluno() && exists(/databases/$(db)/documents/tentativas/$(uid() + '_' + p)));
      allow write: if professor();
    }

    // ---------- tentativas ----------
    match /tentativas/{t} {
      // aluno: a própria. "resource == null" = ainda não começou (a lista de provas confere se já existe);
      // só vale para o id dele (uid_prova), para não descobrir quem começou
      allow read: if equipeGeral()
                  || (resource != null && minhaAluna(resource.data.email.lower()))
                  || (logado() && (resource == null ? t.matches(uid() + '_.+') : resource.data.uid == uid()));

      // ALUNO: cria a própria, uma vez, com a prova liberada
      allow create: if (aluno()
        && t == uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.email == email()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nome', 'provaId', 'bancoId', 'questoesIds',
                                                 'iniciadaEm', 'finalizadaEm', 'indiceAtual', 'trocasDeAba',
                                                 'notaPrevia', 'aguardandoCorrecao',
                                                 'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                                                 'encerradaPor', 'trocasDeAbaTotal', 'codigoInformado'])
        && prova(request.resource.data.provaId).liberada == true
        && request.resource.data.bancoId == prova(request.resource.data.provaId).bancoId
        // nº de questões da prova, ou exatamente as questões sorteadas pelo professor na acessibilidade (quantidade livre)
        && (request.resource.data.questoesIds.size() == prova(request.resource.data.provaId).nQuestoes
            || (request.resource.data.questoesIds.size() > 0
                && request.resource.data.questoesIds == sorteioAcess(request.resource.data.provaId)))
        && request.resource.data.finalizadaEm == null
        && request.resource.data.iniciadaEm == request.time
        // turma: a prova PRECISA ter turma e o e-mail do aluno precisa estar na lista dela (prova sem turma = ninguém faz)
        // (.get com padrão: provas antigas não têm turmaId/codigoAcesso, e campo ausente dá erro nas regras)
        && prova(request.resource.data.provaId).get('turmaId', null) != null
        && email().lower() in get(/databases/$(db)/documents/turmas/$(prova(request.resource.data.provaId).turmaId)).data.emails
        // código de acesso: se a prova tiver, o aluno precisa informar igual
        && (prova(request.resource.data.provaId).get('codigoAcesso', '') in [null, '']
            || request.resource.data.get('codigoInformado', '') == prova(request.resource.data.provaId).codigoAcesso))
      // EQUIPE: tentativa de teste (não exige prova liberada)
      || (equipe()
        && t == 'teste_' + uid() + '_' + request.resource.data.provaId
        && request.resource.data.uid == uid()
        && request.resource.data.get('teste', false) == true)
      // EQUIPE: aluno FICTÍCIO do ambiente de teste (menu Simulação)
      || (professor() && t.matches('sim_.+') && request.resource.data.get('simulado', false) == true);

      allow update: if
           // aluno: só avança, conta sinais e finaliza — nunca mexe nas questões sorteadas nem no placar
           (logado() && resource.data.uid == uid() && resource.data.get('teste', false) != true
            && resource.data.finalizadaEm == null
            && prova(resource.data.provaId).liberada == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['finalizadaEm', 'indiceAtual', 'trocasDeAba',
                  'saidasTelaCheia', 'tentativasColar', 'tempoTotalSegundos',
                  'encerradaPor', 'trocasDeAbaTotal'])
            // vidas: o aluno não "recupera" vidas sozinho (perder a questão zera trocasDeAba, mas soma em trocasDeAbaTotal)
            && request.resource.data.get('trocasDeAba', 0) + request.resource.data.get('trocasDeAbaTotal', 0)
                 >= resource.data.get('trocasDeAba', 0) + resource.data.get('trocasDeAbaTotal', 0))
           // professor: fecha a nota e grava o placar que o aluno vê (acertos, nota prévia, pendentes)
           // e cuida das VIDAS do aluno: restaurar, dar vida extra, reabrir a prova (ex.: aluno com TEA) e apagar sinais registrados por engano
        || (professor()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['nota', 'notaMaxima', 'corrigidaEm', 'corrigidaPor',
                  'acertos', 'totalQuestoes', 'notaPrevia', 'aguardandoCorrecao',
                  'trocasDeAba', 'trocasDeAbaTotal', 'vidasExtras', 'vidasRestauradas', 'vidasRestauradasEm',
                  'vidasRestauradasPor', 'finalizadaEm', 'encerradaPor', 'indiceAtual', 'tempoTotalSegundos',
                  'minutosExtras', 'reabertaEm', 'reabertaPor', 'saidasTelaCheia', 'tentativasColar']))
           // auxiliar de inclusão: vidas e reabrir a prova dos alunos vinculados a ela
        || (minhaAluna(resource.data.email.lower())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['trocasDeAba', 'trocasDeAbaTotal', 'vidasExtras', 'vidasRestauradas', 'vidasRestauradasEm',
                  'vidasRestauradasPor', 'finalizadaEm', 'encerradaPor', 'indiceAtual', 'tempoTotalSegundos',
                  'minutosExtras', 'reabertaEm', 'reabertaPor', 'acertos', 'totalQuestoes', 'nota', 'notaPrevia', 'aguardandoCorrecao',
                  'saidasTelaCheia', 'tentativasColar']))
           // equipe: a própria tentativa de teste
        || (equipe() && resource.data.get('teste', false) == true && resource.data.uid == uid())
        || (professor() && resource.data.get('simulado', false) == true);

      allow delete: if admin() || (equipe() && resource.data.get('teste', false) == true && resource.data.uid == uid())
        || (professor() && resource.data.get('simulado', false) == true);

      // respostas: o aluno grava uma vez; com "ir e voltar" (prova.permitirVoltar) pode alterar até finalizar
      match /respostas/{q} {
        allow read: if equipeGeral() || minhaAluna(tentativa(t).email.lower()) || (logado() && tentativa(t).uid == uid());
        allow create: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && q in tentativa(t).questoesIds
          && request.resource.data.keys().hasOnly(['resposta', 'enviadaEm', 'segundos', 'perdida'])
          && request.resource.data.enviadaEm == request.time)
          || meuTeste(t) || (professor() && t.matches('sim_.+'));
        allow update: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && prova(tentativa(t).provaId).get('permitirVoltar', false) == true
          && resource.data.get('perdida', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'segundos', 'atualizadaEm'])
          && request.resource.data.atualizadaEm == request.time)
          || meuTeste(t) || (professor() && t.matches('sim_.+'));
        allow delete: if admin() || meuTeste(t) || (professor() && t.matches('sim_.+'))
          || (cuidaDe(tentativa(t).email.lower()) && resource.data.get('perdida', false) == true);   // devolver questão perdida por sair da prova
      }

      // correção manual (dissertativas)
      match /correcoes/{q} {
        allow read: if equipeGeral() || minhaAluna(tentativa(t).email.lower())
                    || (logado() && tentativa(t).uid == uid() && prova(tentativa(t).provaId).resultadosLiberados == true);
        allow write: if professor() || (meuTeste(t) && request.method == 'delete');
      }

      // log de saídas por questão (aba, tela cheia, colar) — gravado pelo aluno, lido pela equipe
      match /saidas/{s} {
        allow read: if equipeGeral() || minhaAluna(tentativa(t).email.lower());
        allow create: if (aluno()
          && tentativa(t).uid == uid()
          && tentativa(t).finalizadaEm == null
          && prova(tentativa(t).provaId).liberada == true
          && request.resource.data.keys().hasOnly(['questaoId', 'indice', 'motivo', 'saidaEm'])
          && request.resource.data.motivo in ['aba', 'telaCheia', 'colar']
          && request.resource.data.saidaEm == request.time)
          || meuTeste(t);
        allow update: if (aluno()
          && tentativa(t).uid == uid()
          && resource.data.motivo != 'colar'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voltouEm', 'segundosFora'])
          && request.resource.data.voltouEm == request.time)
          || meuTeste(t);
      }
    }
    // =====================================================================================
    // ECOSSISTEMA (aulas · autoavaliação · provas) — decisões em docs/ECOSSISTEMA.md
    // Os 3 sistemas usam ESTE projeto Firebase (mesmo login, mesmas turmas, mesma equipe).
    // ESTE arquivo é a fonte única das regras (publicado sozinho pelo GitHub Actions deste repositório).
    // =====================================================================================
    function naTurma(t)    { return logado() && t is string && exists(/databases/$(db)/documents/turmas/$(t))
                               && email().lower() in get(/databases/$(db)/documents/turmas/$(t)).data.get('emails', []); }
    function meuDoc()      { return logado() && resource.data.email == email().lower(); }
    function souEu()       { return logado() && request.resource.data.email == email().lower() && request.resource.data.uid == uid(); }

    // ---------- evidências (contrato comum: js/evidencias.js) ----------
    // Um doc por aluno por evento: id = {fonte}__{ref}__{email}. Aluno lê as próprias; equipe lê tudo.
    // O aluno só grava as PRÓPRIAS evidências sem nota (autoavaliação, treino, simulado); aula, atividade e prova:
    // professor ou servidor (Admin SDK). Assim nota nenhuma depende de algo que o aluno gravou.
    match /evidencias/{id} {
      allow read: if equipeGeral() || meuDoc() || minhaAluna(resource.data.email);
      allow create, update: if professor()
        || (aluno() && souEu() && request.resource.data.fonte in ['autoavaliacao', 'treino', 'simulado']
            && id == request.resource.data.fonte + '__' + request.resource.data.ref + '__' + email().lower()
            && (resource == null || (resource.data.email == email().lower() && resource.data.fonte == request.resource.data.fonte)));
      allow delete: if professor();
    }

    // >>> AUTOAVALIACAO (o sistema de autoavaliação edita SÓ entre estes marcadores) >>>
    // respostas completas do aluno (a evidência resumida vai em evidencias/autoavaliacao__…)
    match /autoavaliacoes/{id} {
      allow read: if equipeGeral() || meuDoc() || minhaAluna(resource.data.email);
      allow create, update: if professor() || (aluno() && souEu() && (resource == null || resource.data.email == email().lower()));
      allow delete: if professor();
    }
    // ações de recuperação do professor (orientação, outra explicação, divulgação de conteúdo); a turma lê as dela
    match /recuperacoes/{id} {
      allow read: if equipe() || naTurma(resource.data.turmaId) || (logado() && email().lower() in resource.data.get('alunos', []));
      allow write: if professor();
    }
    // <<< AUTOAVALIACAO <<<

    // >>> AULAS (o sistema de aulas edita SÓ entre estes marcadores; coleções sempre com prefixo "aulas") >>>
    // aula planejada/dada: { unidade, turma, turmaId, periodo, data, aulasNo, titulo, capacidades, criterios, conhecimentos, status, ... }
    match /aulas/{id} {
      allow read: if equipe() || naTurma(resource.data.turmaId);
      allow write: if professor();
    }
    // atividade: { unidade, turma, turmaId, tipo: lancada|prerecuperacao|nivelamento, titulo, enunciado, criterios, prazo, publicada, alunos, ... }
    // alunos == [] → a turma toda lê (consulta com where alunos == []); alunos com e-mails → SÓ esses alunos leem
    // (consulta com where alunos array-contains), para a turma não saber quem foi para a pré-recuperação ou o nivelamento.
    match /aulasAtividades/{id} {
      allow read: if equipe()
        || (resource.data.get('publicada', false) == true
            && ((resource.data.get('alunos', []).size() == 0 && naTurma(resource.data.turmaId))
                || (logado() && email().lower() in resource.data.get('alunos', []))));
      allow write: if professor();
    }
    // entrega do aluno: id = {atividadeId}__{email}; o aluno cria e altera a própria até o professor devolver
    match /aulasEntregas/{id} {
      allow read: if equipeGeral() || meuDoc() || minhaAluna(resource.data.email);
      allow create, update: if professor()
        || (aluno() && souEu() && id == request.resource.data.atividadeId + '__' + email().lower()
            && request.resource.data.get('devolvida', false) != true
            && (resource == null || (resource.data.email == email().lower() && resource.data.get('devolvida', false) != true)));
      allow delete: if professor();
    }
    // sessões ao vivo (como no revisão-SAEP): o sistema de aulas define aqui presença, respostas e dúvidas
    match /aulasSessoes/{id} {
      allow read: if equipe() || naTurma(resource.data.turmaId);
      allow write: if professor();
      match /presenca/{em} {
        allow read: if equipe() || (logado() && em == email().lower());
        allow write: if professor() || (logado() && em == email().lower() && request.resource.data.uid == uid());
      }
      // o aluno responde só com a sessão aberta e antes de o professor revelar o gabarito daquela questão
      match /respostas/{rid} {
        allow read: if equipe() || meuDoc();
        allow create, update: if professor() || (logado() && souEu()
          && get(/databases/$(db)/documents/aulasSessoes/$(id)).data.get('aberta', false) == true
          && !(request.resource.data.qid in get(/databases/$(db)/documents/aulasSessoes/$(id)).data.get('revelados', [])));
        allow delete: if professor();
      }
      match /duvidas/{did} {
        allow read: if equipe() || meuDoc();
        allow create: if logado() && souEu();
        allow update, delete: if professor();
      }
    }
    // slides adaptados por aluno com acessibilidade: id = {aulaId}__{email}. Gerados pela equipe (IA + revisão) a partir do
    // perfil privado; o aluno lê SÓ a versão dele (nunca a descrição nem os laudos, que ficam em acessibilidadePrivado).
    match /aulasAdaptacoes/{id} {
      allow read: if cuidaDe(resource.data.email) || eu(resource.data.email);
      allow create, update: if professor() || minhaAluna(request.resource.data.email);
      allow delete: if professor();
    }
    // <<< AULAS <<<

  }
}
